# Copy to .env for local development. Every value here is a development
# placeholder; the API validates them at startup and refuses to run with
# several of them in production.

# development | production | test
ENV=development
PORT=8080

DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2

# Must be at least 32 characters. Generate one with:  make secret
JWT_SECRET=development-only-secret-not-for-production-use

# Access tokens are short-lived because they are stateless and therefore cannot
# be revoked. The refresh token is the long-lived, revocable half of the pair.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REALTIME_TICKET_TTL=30s

# Explicit allowlist. There is no wildcard option — this API sends credentials,
# and an API that reflects arbitrary origins is readable from any page the user
# happens to visit.
CORS_ORIGINS=http://localhost:5173

# ~250ms per hash on current hardware. Raising it is safe: existing hashes are
# upgraded transparently the next time each user signs in.
BCRYPT_COST=12

# How often the worker looks for tickets past their resolution deadline.
SLA_SWEEP_INTERVAL=1m

# Leave SMTP_HOST empty in development and notifications are written to the log
# instead of sent — a full local setup with no credentials and no risk of
# emailing a real person from a seeded database. It is required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=servicedesk@example.com

# Used to build the ticket links inside notification emails.
PUBLIC_BASE_URL=http://localhost:5173

LOG_LEVEL=info
LOG_FORMAT=text

# Per-instance, in-memory limits. The auth limit is far tighter because those
# endpoints are the target of credential stuffing and have no authenticated
# identity to key on.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
