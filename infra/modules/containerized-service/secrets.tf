# Secrets Manager. ECS reads these at task start and injects them as
# environment variables; they never appear in the task definition, the image,
# or CI logs.
#
# Three kinds:
#   DATABASE_URL       — built here from the RDS instance (create_database only)
#   generated_secrets  — random values Terraform creates and owns
#   external_secrets   — values a human sets; Terraform only creates the slot

# --- DATABASE_URL ------------------------------------------------------------

resource "aws_secretsmanager_secret" "database_url" {
  count = var.create_database ? 1 : 0

  name                    = "${var.name}/DATABASE_URL"
  description             = "Connection string for ${var.name}'s RDS instance"
  recovery_window_in_days = var.secret_recovery_window_days
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "database_url" {
  count = var.create_database ? 1 : 0

  secret_id = aws_secretsmanager_secret.database_url[0].id
  # sslmode=require: encrypted in transit. It does not verify the server
  # certificate (verify-full would need the RDS CA bundle in the image) — see
  # docs/infra/README.md for the upgrade path.
  secret_string = format(
    "postgres://%s:%s@%s/%s?sslmode=require",
    var.db_username,
    random_password.database[0].result,
    aws_db_instance.this[0].endpoint, # host:port
    var.db_name,
  )
}

# --- generated ---------------------------------------------------------------

resource "random_password" "generated" {
  for_each = toset(var.generated_secrets)

  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "generated" {
  for_each = toset(var.generated_secrets)

  name                    = "${var.name}/${each.key}"
  description             = "Generated by Terraform for ${var.name}"
  recovery_window_in_days = var.secret_recovery_window_days
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = toset(var.generated_secrets)

  secret_id     = aws_secretsmanager_secret.generated[each.key].id
  secret_string = random_password.generated[each.key].result
}

# --- external ----------------------------------------------------------------

resource "aws_secretsmanager_secret" "external" {
  for_each = toset(var.external_secrets)

  name                    = "${var.name}/${each.key}"
  description             = "Set out of band: aws secretsmanager put-secret-value --secret-id ${var.name}/${each.key} --secret-string ..."
  recovery_window_in_days = var.secret_recovery_window_days
  tags                    = var.tags
}

# A secret with no value makes every task fail at start
# (ResourceInitializationError), so Terraform writes a placeholder once. The
# app starts; the dependent feature (e.g. email) fails until a human puts the
# real value in. ignore_changes means Terraform never overwrites that value.
resource "aws_secretsmanager_secret_version" "external_placeholder" {
  for_each = toset(var.external_secrets)

  secret_id     = aws_secretsmanager_secret.external[each.key].id
  secret_string = "REPLACE_ME"

  lifecycle {
    ignore_changes = [secret_string]
  }
}

# --- what the task definition sees -------------------------------------------

locals {
  database_url_secret_arn = var.create_database ? aws_secretsmanager_secret.database_url[0].arn : var.existing_database_url_secret_arn

  # env var name => secret ARN
  secret_arns = merge(
    { DATABASE_URL = local.database_url_secret_arn },
    { for k, s in aws_secretsmanager_secret.generated : k => s.arn },
    { for k, s in aws_secretsmanager_secret.external : k => s.arn },
  )
}
